FROM golang:1.27.3 AS build

ENV CGO_ENABLED=0
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -tags timetzdata -ldflags="-w -s" -o /wikipedia-web ./cmd/wikipedia-web

FROM gcr.io/distroless/static-debian13:nonroot

COPY --from=build /wikipedia-web /wikipedia-web

EXPOSE 8080
ENTRYPOINT ["/wikipedia-web"]
